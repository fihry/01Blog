# Frontend Configuration
BACKEND_HOST=backend
BACKEND_PORT=8000
FRONTEND_PORT=4200

# Database Configuration
DB_NAME=<db_name>
DB_USER=<db_user>
DB_PASSWORD=<db_password>
DB_HOST=db
DB_PORT=5432

# Storage (S3-Compatible) - Alarik Ports
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Storage URLs
STORAGE_API_BASE_URL=http://localhost:9000
STORAGE_CONSOLE_BASE_URL=http://localhost:9001

# Storage Credentials
ALARIK_ADMIN_USERNAME=<admin_username>
ALARIK_ADMIN_PASSWORD=<admin_password>
STORAGE_ACCESS_KEY=<s3_access_key>
STORAGE_SECRET_KEY=<s3_secret_key>

# Storage S3 Configuration
STORAGE_BUCKET=uploads
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://storage:8080
STORAGE_PUBLIC_URL=http://localhost:9000

# Alarik Settings
ALARIK_ALLOW_ACCOUNT_CREATION=false

# App Configuration
JWT_SECRET=<jwt_secret>
JWT_EXPIRATION=86400000